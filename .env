# ============================================================================
# HelloAgents 统一环境变量配置文件
# ============================================================================
# 复制此文件为 .env 并填入你的API密钥
# 系统要求：Python 3.10+ （必需）

# ============================================================================
# 🚀 统一配置格式（推荐）- 框架自动检测provider
# ============================================================================
# 只需配置以下4个通用环境变量，框架会自动识别LLM提供商：

# 模型名称
LLM_MODEL_ID=qwen3.7-plus
SUMMARIZER_MODEL_ID=qwen3.7-plus
PREFERENCE_MODEL_ID=qwen3.7-plus
# API密钥
LLM_API_KEY=sk-17e00158fdc143b2aa80e32e6eefcc14
SUMMARIZER_API_KEY=sk-17e00158fdc143b2aa80e32e6eefcc14
PREFERENCE_API_KEY=sk-17e00158fdc143b2aa80e32e6eefcc14
# 服务地址
LLM_BASE_URL=https://ws-06luduvpfh4renzg.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
SUMMARIZER_BASE_URL=https://ws-06luduvpfh4renzg.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
PREFERENCE_BASE_URL=https://ws-06luduvpfh4renzg.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 超时时间（可选，默认60秒）
LLM_TIMEOUT=60

# ============================================================================
# 🛠️ 工具配置（可选）
# ============================================================================

# Tavily搜索（推荐）- 获取API密钥：https://tavily.com/
# TAVILY_API_KEY=tvly-your_tavily_key_here

# SerpApi搜索（备选）- 获取API密钥：https://serpapi.com/
# SERPAPI_API_KEY=your_serpapi_key_here

# ================================
# Qdrant 向量数据库配置 - 获取API密钥：https://cloud.qdrant.io/
# ================================
# 使用Qdrant云服务 (推荐)
#QDRANT_URL=https://your-cluster.qdrant.tech:6333
#QDRANT_API_KEY=your_qdrant_api_key_here

# 或使用本地Qdrant (需要Docker)
QDRANT_URL=http://192.168.150.101:6333
QDRANT_API_KEY=dshaxxy

# Qdrant集合配置
QDRANT_COLLECTION=hello_agents_vectors
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=30

# ================================
# Neo4j 图数据库配置 - 获取API密钥：https://neo4j.com/cloud/aura/
# ================================
# 使用Neo4j Aura云服务 (推荐)
#NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
#NEO4J_USERNAME=neo4j
#NEO4J_PASSWORD=your_neo4j_password_here

# 或使用本地Neo4j (需要Docker)
NEO4J_URI=bolt://192.168.150.101:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=12345678

# Neo4j连接配置
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=60

# ==========================
# 嵌入（Embedding）配置示例 - 可从阿里云控制台获取：https://dashscope.aliyun.com/
# ==========================
# - 若为空，dashscope 默认 text-embedding-v3；local 默认 sentence-transformers/all-MiniLM-L6-v2
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=text-embedding-v4
EMBED_API_KEY=sk-17e00158fdc143b2aa80e32e6eefcc14
EMBED_BASE_URL=https://ws-06luduvpfh4renzg.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# ==========================
# 高德地图配置 - 获取API密钥：https://lbs.amap.com/
# ==========================
AMAP_MAPS_API_KEY=ec53e40927a14935d249b8d262aeac51

# ==========================
# Unsplash图片库配置 - 获取API密钥：https://unsplash.com/developers/
# ==========================
UNSPLASH_ACCESS_KEY=N2VjW1BoGtPkhaynaZq7gjNsjlk7eEa6RFt3mS94-5g
UNSPLASH_SECRET_KEY=OQT_kNfCpjfkYmicJLLm27mG2lLXUjktE7sNGz9rPpI
